---
import Base from './Base.astro';
import { withBase } from '../lib/path';

type Props = {
  title?: string;
  active?: 'home' | 'archive' | 'stat';
  /** ロゴ見出しのリンク先。現行の default.html はページ自身の URL を指していた。 */
  href: string;
};

const { title, active, href } = Astro.props;
---

<Base title={title} active={active}>
  <div id="title">
    <a href={href}><h1><img src={withBase('/images/logo.png')} alt="vimrc読書会" /></h1></a>
    <p></p>
    <hr />
  </div>
  <slot />
</Base>
